<div id="<%= dom_id organization %>">
  <p>
    <strong>団体名:</strong>
    <%= organization.name %>
  </p>

  <p>
    <strong>担当者:</strong>
    <%= organization.pic %>
  </p>

  <p>
    <strong>郵便番号:</strong>
    <%= organization.postal_code %>
  </p>

  <p>
    <strong>所在地:</strong>
    <%= organization.address %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= organization.email %>
  </p>

  <p>
    <strong>許可日:</strong>
    <%= organization.agreement_at %>
  </p>

  <p>
    <strong>電話:</strong>
    <%= organization.tel %>
  </p>

  <p>
    <strong>FAX:</strong>
    <%= organization.fax %>
  </p>

</div>
