<div id="<%= dom_id organization %>">
  <p>
    <strong>Name:</strong>
    <%= organization.name %>
  </p>

  <p>
    <strong>Pic:</strong>
    <%= organization.pic %>
  </p>

  <p>
    <strong>Postal code:</strong>
    <%= organization.postal_code %>
  </p>

  <p>
    <strong>Address:</strong>
    <%= organization.address %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= organization.email %>
  </p>

  <p>
    <strong>Agreement at:</strong>
    <%= organization.agreement_at %>
  </p>

  <p>
    <strong>Tel:</strong>
    <%= organization.tel %>
  </p>

  <p>
    <strong>Fax:</strong>
    <%= organization.fax %>
  </p>

</div>
