<%= form_with(model: organization) do |form| %>
  <% if organization.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(organization.errors.count, "error") %> prohibited this organization from being saved:</h2>

      <ul>
        <% organization.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, '団体名', style: "display: block" %>
    <%= form.text_field :name, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :pic, '担当者', style: "display: block" %>
    <%= form.text_field :pic, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :postal_code, '郵便番号', style: "display: block" %>
    <%= form.text_field :postal_code, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :address, '所在地', style: "display: block" %>
    <%= form.text_field :address, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.text_field :email, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :agreement_at, '許可日', style: "display: block" %>
    <%= form.date_field :agreement_at, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :tel, '電話', style: "display: block" %>
    <%= form.text_field :tel, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :fax, style: "display: block" %>
    <%= form.text_field :fax, class: 'form-control' %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
